@model School_Management_System.Models.Student
@{
    ViewData["Title"] = "Student Details";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@section Styles {
<style>
    .student-detail { max-width: 900px; margin: 0 auto; }
    .student-detail-head { display:flex; justify-content:space-between; align-items:center; gap:1rem; margin-bottom:1rem; flex-wrap:wrap; }
    .student-detail-back { color:#000666; font-size:.85rem; font-weight:700; text-decoration:none; }
    .student-detail-back:hover { text-decoration:underline; }
    .student-detail-actions { display:flex; gap:.6rem; }
    .student-detail-btn { display:inline-flex; align-items:center; gap:.4rem; padding:.55rem .9rem; border-radius:8px; font-size:.8rem; font-weight:700; text-decoration:none; }
    .student-detail-btn.edit { border:1px solid #f2c078; color:#9a5b00; background:#fffaf0; }
    .student-detail-card { overflow:hidden; background:#fff; border:1px solid #dfe2ec; border-radius:14px; box-shadow:0 4px 16px rgba(15,23,42,.06); }
    .student-detail-banner { display:flex; align-items:center; gap:1rem; padding:1.5rem 1.75rem; background:linear-gradient(120deg,#000666,#243b9b); color:#fff; }
    .student-detail-photo { width:78px; height:78px; border-radius:50%; object-fit:cover; border:3px solid rgba(255,255,255,.65); background:#fff; }
    .student-detail-name { margin:0; font-size:1.35rem; font-weight:800; }
    .student-detail-class { margin:.25rem 0 .6rem; color:#dbe3ff; font-size:.9rem; }
    .student-detail-status { display:inline-block; padding:.25rem .65rem; border-radius:999px; background:rgba(255,255,255,.16); color:#fff; font-size:.72rem; font-weight:800; text-transform:uppercase; }
    .student-detail-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:1.25rem 2rem; padding:1.5rem 1.75rem; }
    .student-detail-field label { display:block; margin-bottom:.3rem; color:#667085; font-size:.7rem; font-weight:800; letter-spacing:.06em; text-transform:uppercase; }
    .student-detail-field span { color:#1d2939; font-size:.92rem; font-weight:600; overflow-wrap:anywhere; }
    @@media (max-width:600px) { .student-detail-grid { grid-template-columns:1fr; gap:1rem; padding:1.25rem; } .student-detail-banner { padding:1.25rem; } }
</style>
}

<div class="student-detail">
    <div class="student-detail-head">
        <a class="student-detail-back" href="/Students"><i class="bi bi-arrow-left"></i> Back to Students</a>
        <div class="student-detail-actions">
            <a class="student-detail-btn edit" href="/Students/Edit/@Model.Id"><i class="bi bi-pencil"></i> Edit Student</a>
        </div>
    </div>

    <article class="student-detail-card">
        <header class="student-detail-banner">
            <img class="student-detail-photo" src="@Model.PhotoPath" onerror="this.src='/images/default-avatar.png'" alt="@Model.FullName" />
            <div>
                <h1 class="student-detail-name">@Model.FullName</h1>
                <div class="student-detail-class">@(Model.Class?.Name ?? "No class assigned")</div>
                <span class="student-detail-status">@Model.Status</span>
            </div>
        </header>

        <div class="student-detail-grid">
            <div class="student-detail-field"><label>Full Name</label><span>@Model.FullName</span></div>
            <div class="student-detail-field"><label>LIN</label><span>@(string.IsNullOrWhiteSpace(Model.LIN) ? "Not yet assigned" : Model.LIN)</span></div>
            <div class="student-detail-field"><label>Gender</label><span>@Model.Gender</span></div>
            <div class="student-detail-field"><label>Date of Birth</label><span>@Model.DOB.ToString("dd MMM yyyy")</span></div>
            <div class="student-detail-field"><label>Class</label><span>@(Model.Class?.Name ?? "No class assigned")</span></div>
            <div class="student-detail-field"><label>Status</label><span>@Model.Status</span></div>
            <div class="student-detail-field"><label>Term</label><span>@(string.IsNullOrWhiteSpace(Model.Term) ? "—" : Model.Term)</span></div>
            <div class="student-detail-field"><label>Guardian Name</label><span>@(string.IsNullOrWhiteSpace(Model.GuardianName) ? "—" : Model.GuardianName)</span></div>
            <div class="student-detail-field"><label>Guardian Contact</label><span>@(string.IsNullOrWhiteSpace(Model.GuardianContact) ? "—" : Model.GuardianContact)</span></div>
            <div class="student-detail-field"><label>Enrolled</label><span>@Model.EnrolledDate.ToString("dd MMM yyyy")</span></div>
            <div class="student-detail-field"><label>Login Username</label><span>@(Model.User?.Username ?? "—")</span></div>
        </div>
    </article>
</div>
