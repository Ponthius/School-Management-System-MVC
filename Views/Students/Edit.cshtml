@model School_Management_System.Models.ViewModels.StudentEditViewModel
@{
    ViewData["Title"] = "Edit Student";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@section Styles {
<style>
    .se { max-width: 1040px; margin: 0 auto; }

    /* breadcrumb + page title */
    .se-crumbs { display:flex; align-items:center; gap:.5rem; margin-bottom:.75rem; font-size:.85rem; color:#7a8199; flex-wrap:wrap; }
    .se-crumbs a { color:#000666; text-decoration:none; font-weight:600; }
    .se-crumbs a:hover { text-decoration:underline; }
    .se-title { margin:0 0 1.25rem; font-size:1.45rem; font-weight:700; color:#101828; }

    /* layout */
    .se-cols { display:grid; grid-template-columns:310px 1fr; gap:1.25rem; align-items:start; }
    .se-stack { display:flex; flex-direction:column; gap:1.25rem; }
    .se-card { background:#fff; border:1px solid #e3e6ef; border-radius:12px; box-shadow:0 1px 3px rgba(16,24,40,.06); }
    .se-card h2 { margin:0; padding:.9rem 1.25rem; font-size:.95rem; font-weight:700; color:#101828; border-bottom:1px solid #e9ecf3; display:flex; align-items:center; gap:.5rem; }
    .se-card h2 i { color:#000666; }
    .se-body { padding:1.25rem; }

    /* photo card */
    .se-photo-wrap { display:flex; flex-direction:column; align-items:center; text-align:center; padding:1.5rem 1.25rem; }
    .se-photo { width:132px; height:132px; border-radius:50%; object-fit:cover; background:#fff; border:5px solid #fff; box-shadow:0 0 0 1px #dfe2ec, 0 2px 8px rgba(16,24,40,.15); }
    .se-upload { display:inline-flex; align-items:center; gap:.45rem; margin-top:1rem; padding:.5rem .9rem; border:1px solid #cfd4e2; border-radius:8px; background:#fff; color:#1d2939; font-size:.85rem; font-weight:600; cursor:pointer; }
    .se-upload:hover { background:#f5f6fb; border-color:#000666; color:#000666; }
    .se-file { position:absolute; width:1px; height:1px; opacity:0; overflow:hidden; }
    .se-file:focus-visible + .se-upload, .se-upload:focus-within { outline:2px solid #3b4fe0; outline-offset:2px; }
    .se-hint { margin-top:.6rem; color:#7a8199; font-size:.8rem; line-height:1.4; }

    /* form fields */
    .se-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:1.1rem 1.25rem; }
    .se-full { grid-column:span 2; }
    .se-field label { display:block; margin-bottom:.35rem; color:#344054; font-size:.85rem; font-weight:600; }
    .se-field input:not([type=hidden]), .se-field select {
        box-sizing:border-box; width:100%; min-height:42px; padding:.55rem .75rem;
        border:1px solid #cfd4e2; border-radius:8px; background:#fff;
        color:#101828; font-size:.92rem; font-family:inherit;
    }
    .se-field input::placeholder { color:#98a2b3; }
    .se-field input:hover, .se-field select:hover { border-color:#a9b0c6; }
    .se-field input:focus, .se-field select:focus { outline:none; border-color:#000666; box-shadow:0 0 0 3px rgba(0,6,102,.12); }
    .se-note { display:block; margin-top:.35rem; color:#7a8199; font-size:.8rem; }
    .se-error { display:block; margin-top:.3rem; color:#b42318; font-size:.8rem; }
    .se-error:empty { display:none; }

    /* action bar */
    .se-actions { display:flex; justify-content:flex-end; align-items:center; gap:.75rem; padding:1rem 1.25rem; background:#fff; border:1px solid #e3e6ef; border-radius:12px; box-shadow:0 1px 3px rgba(16,24,40,.06); }
    .se-btn { display:inline-flex; align-items:center; gap:.45rem; padding:.6rem 1.15rem; border-radius:8px; font-size:.88rem; font-weight:600; text-decoration:none; cursor:pointer; font-family:inherit; }
    .se-btn.ghost { background:#fff; color:#475467; border:1px solid #cfd4e2; }
    .se-btn.ghost:hover { background:#f5f6fb; color:#101828; }
    .se-btn.primary { background:#000666; color:#fff; border:1px solid #000666; }
    .se-btn.primary:hover { background:#0a1180; }

    @@media (max-width:860px) {
        .se-cols { grid-template-columns:1fr; }
    }
    @@media (max-width:560px) {
        .se-grid { grid-template-columns:1fr; }
        .se-full { grid-column:auto; }
        .se-actions { flex-direction:column-reverse; align-items:stretch; }
        .se-btn { justify-content:center; }
    }
</style>
}

<div class="se">
    <nav class="se-crumbs" aria-label="Breadcrumb">
        <a href="/Students">Students</a>
        <i class="bi bi-chevron-right" style="font-size:.7rem"></i>
        <a href="/Students/Details/@Model.Id">@Model.FullName</a>
        <i class="bi bi-chevron-right" style="font-size:.7rem"></i>
        <span>Edit</span>
    </nav>
    <h1 class="se-title">Edit student</h1>

    <form asp-action="Edit" asp-controller="Students"
          asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="ExistingPhoto" />

        <div class="se-cols">
            <!-- Left: photo -->
            <div class="se-stack">
                <section class="se-card">
                    <h2><i class="bi bi-camera"></i> Photo</h2>
                    <div class="se-photo-wrap">
                        <img id="photoPreview" class="se-photo" src="@Model.ExistingPhoto"
                             onerror="this.src='/images/default-avatar.png'" alt="Student photo" />

                        <input type="file" asp-for="Photo" accept="image/*" class="se-file" onchange="previewPhoto(this)" />
                        <label for="Photo" class="se-upload"><i class="bi bi-upload"></i> Choose new photo</label>

                    
                    </div>
                </section>
            </div>

            <!-- Right: details -->
            <div class="se-stack">
                <section class="se-card">
                    <h2><i class="bi bi-person-vcard"></i> Personal details</h2>
                    <div class="se-body">
                        <div class="se-grid">
                            <div class="se-field se-full">
                                <label for="FullName">Full name</label>
                                <input asp-for="FullName" autocomplete="off" />
                                <span asp-validation-for="FullName" class="se-error"></span>
                            </div>

                            <div class="se-field se-full">
                                <label for="LIN">Learner Identification Number (LIN)</label>
                                <input asp-for="LIN" placeholder="Official EMIS LIN" autocomplete="off" />
                            
                                <span asp-validation-for="LIN" class="se-error"></span>
                            </div>

                            <div class="se-field">
                                <label for="Gender">Gender</label>
                                <select asp-for="Gender">
                                    <option value="Male">Male</option>
                                    <option value="Female">Female</option>
                                </select>
                            </div>

                            <div class="se-field">
                                <label for="DOB">Date of birth</label>
                                <input asp-for="DOB" type="date" />
                                <span asp-validation-for="DOB" class="se-error"></span>
                            </div>
                        </div>
                    </div>
                </section>

                <section class="se-card">
                    <h2><i class="bi bi-mortarboard"></i> School record</h2>
                    <div class="se-body">
                        <div class="se-grid">
                            <div class="se-field">
                                <label for="ClassId">Class</label>
                                <select asp-for="ClassId" asp-items="ViewBag.Classes"></select>
                            </div>

                            <div class="se-field">
                                <label for="Status">Status</label>
                                <select asp-for="Status">
                                    <option value="New">New</option>
                                    <option value="Continuing">Continuing</option>
                                </select>
                            </div>

                            <div class="se-field">
                                <label for="Term">Term</label>
                                <select asp-for="Term">
                                    <option value="Term 1">Term 1</option>
                                    <option value="Term 2">Term 2</option>
                                    <option value="Term 3">Term 3</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </section>

                <section class="se-card">
                    <h2><i class="bi bi-people"></i> Guardian</h2>
                    <div class="se-body">
                        <div class="se-grid">
                            <div class="se-field">
                                <label for="GuardianName">Guardian name</label>
                                <input asp-for="GuardianName" autocomplete="off" />
                            </div>

                            <div class="se-field">
                                <label for="GuardianContact">Guardian phone</label>
                                <input asp-for="GuardianContact" type="tel" autocomplete="off" />
                            </div>
                        </div>
                    </div>
                </section>

                <div class="se-actions">
                    <a href="/Students/Details/@Model.Id" class="se-btn ghost">Cancel</a>
                    <button type="submit" class="se-btn primary"><i class="bi bi-check-lg"></i> Save changes</button>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        function previewPhoto(input) {
          if (input.files && input.files[0]) {
            const reader = new FileReader();
            reader.onload = e => document.getElementById('photoPreview').src = e.target.result;
            reader.readAsDataURL(input.files[0]);
          }
        }
    </script>
}
